{
  "name": "ai-test",
  "version": "1.2.0",
  "private": false,
  "description": "Bộ web app ôn tập AI thực chiến self-host/local host, có GitHub Actions validate và auto-merge PR đề bổ sung.",
  "type": "module",
  "scripts": {
    "generate:crown-lock": "node scripts/generate-crown-lock.mjs",
    "generate:final-lock": "node scripts/generate-final-lock.mjs",
    "index:finals": "node scripts/index-final-sources.mjs",
    "materialize:new-exams": "node scripts/materialize-new-exams.mjs",
    "predev": "npm run materialize:new-exams && npm run generate:crown-lock",
    "dev": "vite",
    "prebuild": "npm run materialize:new-exams && npm run generate:crown-lock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prevalidate": "npm run materialize:new-exams",
    "validate": "node scripts/validate-expanded.mjs && npm run validate:finals && node --test scripts/validate-finals.test.mjs scripts/final-vault.test.mjs && npm run test:crown",
    "validate:finals": "node scripts/validate-finals.mjs",
    "validate:finals:complete": "node scripts/validate-finals.mjs --complete",
    "validate:finals:phase1": "node scripts/validate-finals.mjs --phase1-complete",
    "test:crown": "node --test scripts/generate-crown-lock.test.mjs && vitest run src"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^5.4.0",
    "typescript": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
