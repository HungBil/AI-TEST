{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-test-crown-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://hungbil.github.io,http://localhost:5173,http://127.0.0.1:5173",
    "TOKEN_TTL_SECONDS": "21600"
  },
  "secrets": {
    "required": ["CROWN_PASSWORD", "CROWN_TOKEN_SECRET"]
  },
  "ratelimits": [
    {
      "name": "CROWN_CLIENT_LIMITER",
      "namespace_id": "26072801",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "CROWN_GLOBAL_LIMITER",
      "namespace_id": "26072802",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
